# PhishLens configuration. Copy to server/.env (or export in your shell / process manager).
# Every variable is optional; defaults are shown.

# --- Server ------------------------------------------------------------------
NODE_ENV=development            # production serves client/dist from the API server
HOST=127.0.0.1                  # bind address; keep loopback unless behind a reverse proxy
PORT=4000
DATABASE_PATH=data/phishlens.db # relative to server/
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false               # true only behind exactly one trusted reverse proxy

# --- Collection (outbound network) -----------------------------------------------
NETWORK_PROBES_ENABLED=true     # false = no DNS/TLS/HTTP/RDAP; those stages report "unavailable"
RDAP_ENABLED=true               # sends investigated registrable domains to rdap.org / the registry
RDAP_BOOTSTRAP_URL=https://rdap.org/domain/
DNS_SERVERS=                    # e.g. 1.1.1.1,9.9.9.9 ; empty = system resolver
REQUEST_TIMEOUT_MS=6000
DNS_TIMEOUT_MS=3000
MAX_REDIRECTS=8
MAX_BODY_BYTES=131072           # HTML read per hop for static inspection
ALLOWED_PORTS=80,443,8080,8443  # outbound port allow-list
MAX_NETWORK_TARGETS=6           # hosts probed per investigation
MAX_MESSAGE_LINK_PROBES=3       # message links whose redirects are followed

# --- Data handling ------------------------------------------------------------------
RETAIN_RAW_CONTENT=false        # true = store raw headers/message bodies (otherwise SHA-256 + length only)
RETENTION_DAYS=30               # 0 = keep forever

# --- Abuse protection ---------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120              # API requests per window per IP
RATE_LIMIT_CREATE_MAX=10        # new investigations (and AI summaries) per window per IP
MAX_CONCURRENT_INVESTIGATIONS=2

# --- Brand watchlist seed (used once, when the database is created) ------------------
BRANDS_SEED_FILE=config/brands.json

# --- Optional reputation providers (all off by default; unconfigured = "not checked", never "clean") --
GSB_API_KEY=                    # Google Safe Browsing v4 Lookup. Free; NON-COMMERCIAL use only (commercial: Google Web Risk, paid)
URLHAUS_AUTH_KEY=               # abuse.ch Auth-Key (free account at auth.abuse.ch)
VIRUSTOTAL_API_KEY=             # free public key: 4 req/min, 500/day; NOT for commercial products; lookups become visible to VT's community
TRANCO_ENABLED=false            # Tranco popularity ranking, no key, 1 req/s; sends looked-up domains to tranco-list.eu
TRANCO_RANK_THRESHOLD=100000    # "popular" = within this rank ...
TRANCO_MIN_DAYS=25              # ... on at least this many recent daily lists
REPUTATION_TIMEOUT_MS=5000
REPUTATION_CACHE_TTL_HOURS=24   # fresh results reused within this window; expired results resurface only as "stale"
REPUTATION_STALE_AFTER_DAYS=7   # provider data older than this is stale (not counted)

# --- Optional AI narrative (off by default; never affects verdicts) ------------------
AI_PROVIDER=none                # none | anthropic
ANTHROPIC_API_KEY=              # or rely on an `ant auth login` profile
AI_MODEL=claude-opus-5-5
